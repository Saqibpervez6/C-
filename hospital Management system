Set current_time = 0
For each patient i = 1 to n
If current_time < arrival time
current_time = arrival time
End If

waiting = current_time - arrival
current_time = current_time + treatment
turnaround = waiting + treatment
End For

// First Fit Bed Allocation
For each patient i = 1 to n
Set allocated_flag = 0
For each bed j = 1 to m
If bed is free AND bed size >= patient bed requirement
Allocate bed j to patient i
Mark bed as occupied
allocated_flag = 1
Break
End If
End For
If allocated_flag = 0
Print "Patient i could not get a bed"
End If
End For

// Display Results
Print Table: Patient ID, Arrival, Treatment, Waiting, Turnaround

End
