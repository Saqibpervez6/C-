#include <stdio.h>
#include <stdlib.h>

struct Patient {
int id;
int arrival;
int treatment;
int waiting;
int turnaround;
int bedSize;
int startTime;
int bedAssigned;
};

struct Bed {
int id;
int size;
int releaseTime;
};

// Comparator for sorting patients by arrival time
int compareArrival(const void *a, const void *b) {
struct Patient *p1 = (struct Patient *)a;
struct Patient *p2 = (struct Patient *)b;
return p1->arrival - p2->arrival;
}

int main() {
int n, m, i, j;

printf("Enter number of patients: ");
scanf("%d", &n);

struct Patient patients[n];

for (i = 0; i < n; i++) {
patients[i].id = i + 1;
printf("\nEnter arrival time of Patient %d: ", i + 1);
scanf("%d", &patients[i].arrival);
printf("Enter treatment time of Patient %d: ", i + 1);
scanf("%d", &patients[i].treatment);
printf("Enter bed size required for Patient %d: ", i + 1);
scanf("%d", &patients[i].bedSize);
patients[i].waiting = 0;
patients[i].turnaround = 0;
patients[i].startTime = 0;
patients[i].bedAssigned = -1;
}

printf("\nEnter number of hospital beds: ");
scanf("%d", &m);

struct Bed beds[m];

for (i = 0; i < m; i++) {
beds[i].id = i + 1;
printf("Enter size of Bed %d: ", i + 1);
scanf("%d", &beds[i].size);
beds[i].releaseTime = 0;
}

qsort(patients, n, sizeof(struct Patient), compareArrival);

int currentTime = 0;
for (i = 0; i < n; i++) {
if (currentTime < patients[i].arrival) {
currentTime = patients[i].arrival;
}


patients[i].startTime = currentTime;
patients[i].waiting = currentTime - patients[i].arrival;
currentTime += patients[i].treatment;
patients[i].turnaround = patients[i].waiting + patients[i].treatment;

int bedAllocated = 0;
for (j = 0; j < m; j++) {
if (patients[i].startTime >= beds[j].releaseTime && patients[i].bedSize <= beds[j].size) {
beds[j].releaseTime = patients[i].startTime + patients[i].treatment;
patients[i].bedAssigned = beds[j].id;
bedAllocated = 1;
break;
}
}
}

printf("\n\n--- Patient Scheduling and Bed Allocation Results ---\n");
printf("ID\tArrival\tTreatment\tWaiting\tTurnaround\tBed Assigned\n");
for (i = 0; i < n; i++) {
printf("%d\t%d\t%d\t\t%d\t%d\t\t",
patients[i].id,
patients[i].arrival,
patients[i].treatment,
patients[i].waiting,
patients[i].turnaround
);
if (patients[i].bedAssigned == -1)
printf("Not Assigned\n");
else
printf("Bed %d\n", patients[i].bedAssigned);
}


float totalWaiting = 0, totalTurnaround = 0;
for (i = 0; i < n; i++) {
totalWaiting += patients[i].waiting;
totalTurnaround += patients[i].turnaround;
}

printf("\nAverage Waiting Time: %.2f\n", totalWaiting / n);
printf("Average Turnaround Time: %.2f\n", totalTurnaround / n);

return 0;
}

PSEUDOCODE:
