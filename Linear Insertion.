package user;

public class LinearArrayInsertion {
public static void main(String []args) {
	int []arr = new int [10];
 int n= 5;
 arr[0]=10;
 arr[1]=23;
 arr[2]=10;
 arr[3]=22;
 arr[4]=6;
 arr[5]=9;
 
 System.out.println(" before insertion:");
 printArray(arr, n);
 int pos=3;
 int item=00;
 
 n= insert(arr,n,pos,item);
 System.out.println("after insertion:");
 printArray(arr,n);
}
public static int insert(int[] arr, int n, int pos, int item) {
	if(n== arr.length) {
		System.out.println("array oveflow!cannnot insert");
		return n;
	}
	for(int i = n-1; i<=pos;i--) {
		arr[i+1] =arr[i];
	}
arr[pos]=item;
return n+1;
}
public static void printArray(int[]arr,int n) {
	for(int i=0; i<n; i++) {
		System.out.println(arr[i]+"");
	}
System.out.println();

	
}
}
