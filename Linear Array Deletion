package user;

public class LinearArrayDeletion {
public static void main(String []args) {
	int [] arr = {10,20,30,40,50};
	int n=5;
	System.out.println("before deletion");
	printArray(arr,n);
	 int pos=2;
	 n=delete(arr,n,pos);
	 System.out.println("after deletion:");
	 printArray(arr,n);
}
public static int delete(int [] arr, int n, int pos) {
	if(n==0) {
		System.out.println("array undeflow cannnot delete");
		return n;
	}
	if(pos<0 || pos >=n) {
		System.out.println("invalid posiition");
		return n;
	}
	for(int i= pos; i<n-1;i++) {
		arr[i]=arr[i+1];
	}
	return n-1;
}
public static void printArray(int[] arr, int n) {
	for (int i=0; i<n;i++) {
		System.out.println(arr[i]+" ");
	}
	System.out.println();
}
}
